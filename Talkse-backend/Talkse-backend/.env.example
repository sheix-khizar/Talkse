ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

CLERK_SECRET_KEY=sk_test_your_key_here

# SignalWire Telephony & Cloudflare Configuration
SIGNALWIRE_SPACE=your_space.signalwire.com
SIGNALWIRE_PROJECT=your_project_id
SIGNALWIRE_TOKEN=your_token
SIGNALWIRE_SIGNING_KEY=your_signing_key
PUBLIC_HOST=your-tunnel-domain.trycloudflare.com